# Custom .htaccess for Hostinger Static Hosting
DirectoryIndex index.html

# Enable UTF-8
AddDefaultCharset font-woff2

# Error handling
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request is for a directory that exists, but doesn't have a trailing slash, redirect to add it
    # This helps with Next.js trailingSlash: true
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteCond %{REQUEST_URI} !(.*)/$
    RewriteRule ^(.*)$ %{REQUEST_URI}/ [L,R=301]

    # Optional: Serve .html files without the extension (if they exist)
    # This is a fallback if trailingSlash: true wasn't used, but we are using it.
</IfModule>
